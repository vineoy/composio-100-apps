# Free API keys — copy this file to .env and fill in the values.
# NEVER commit .env (it is gitignored). No paid keys are ever needed.

# Google AI Studio (Gemini) — free, no credit card: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Composio — free plan, no credit card: https://dashboard.composio.dev (Settings -> API Keys)
COMPOSIO_API_KEY=
